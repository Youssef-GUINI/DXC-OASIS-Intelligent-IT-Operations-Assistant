# Copier ce fichier en backend/.env et renseigner les valeurs reelles.
# backend/.env n'est pas suivi par git (.gitignore) : il contient des secrets.

# ==========================================
# APPLICATION
# ==========================================
# APP_ENV=development
# DEBUG=true

# ==========================================
# DATABASE -- requis
# ==========================================
DATABASE_URL=postgresql://oasis:motdepasse@localhost:5432/oasis

# ==========================================
# JWT -- requis
# ==========================================
# Generer une valeur unique : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ==========================================
# CHROMADB
# ==========================================
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ==========================================
# LLM -- GROQ_API_KEY requis
# ==========================================
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# ==========================================
# STORAGE VM (SSH) -- optionnels
# Absents, les outils MCP de capacite renvoient une erreur explicite a
# l'appel au lieu de bloquer le demarrage du backend.
# ==========================================
STORAGE_VM_HOST=
STORAGE_VM_PORT=22
STORAGE_VM_USER=
STORAGE_VM_SSH_KEY_PATH=

# ==========================================
# DATA HUB
# ==========================================
# UPLOAD_DIR=uploads

# ==========================================
# RAG / EMBEDDINGS
# Changer le modele invalide les collections Chroma deja construites :
# relancer `python -m app.rag.reindex` apres modification.
# ==========================================
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# EMBEDDING_QUERY_PREFIX="query: "
# EMBEDDING_PASSAGE_PREFIX="passage: "
